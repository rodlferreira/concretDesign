PORT=3001
HOST=127.0.0.1
NODE_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_PATH=./data/quotes.sqlite
# Chave base64 de 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
RETENTION_DAYS=90
# Facultativo: notificações de orçamento (os pedidos persistem mesmo sem SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
QUOTE_EMAIL=geral@concretdesign.pt
# Apenas IPs exatos dos proxies sob o seu controlo; vazio desativa trust proxy.
# Exemplo Nginx no mesmo servidor: 127.0.0.1,::1,::ffff:127.0.0.1
TRUSTED_PROXY_IPS=
